+echo "Job:        $job_name"
+echo "Model:      $MODEL"
+echo "Technique:  $technique"
+echo "Config:     $technique_desc"
+echo "Dataset:    $DATASET"
+echo "Seed:       $SEED"
+echo "Time limit: $time_limit"
+echo "GPU:        $gpu_resource"
+echo "CPUs / Mem: $cpus / $mem"
+echo "CSV:        \$BILLM_BENCH_CSV"
+echo "Cache root: \$CACHE_ROOT (\$HF_HOME)"
+echo "TMPDIR:     \$TMPDIR"
+echo "Started:    \$(date)"
