+./sbatch/run_olmo2_1b_benchmark.sh   --account def-xxx   #  2 jobs
+./sbatch/run_granite_3.3_2b_benchmark.sh --account def-xxx #  2 jobs
+./sbatch/run_smollm2_1.7b_awq_benchmark.sh --account def-xxx #  1 job (AWQ arm)
+./sbatch/run_granite_3.3_2b_awq_benchmark.sh --account def-xxx #  1 job (AWQ arm)
+```
+
