+// RACE FIX (DOML kernel project, 2026-07-06): direct generic-proxy volatile
+// vectorized global load. The original global_reduce fetched the previous
+// threadblock's FP16 partial results from C via cp.async (async proxy).
+// cp.async reads are not guaranteed to be ordered with the generic-proxy
+// ld.global.acquire / fence.acq_rel lock protocol of barrier_acquire /
+// barrier_release (PTX cross-proxy memory-model rule; see also upstream
+// issue IST-DASLab/marlin#42). On A40 (SM86) built with CUDA 12.5 this is a
+// real, measured data race: nondeterministic outputs (max elementwise diff
+// ~20-45) for prob_m >= 512 whenever a column slice is k-split across
+// threadblocks. Loading the partials with ld.volatile.global.v4 keeps the
+// access in the generic proxy, where the acquire fence orders it correctly.
+// Semantics are otherwise identical to the original code.
+__device__ inline int4 ld_volatile_global4(const void* glob_ptr) {
+  int4 v;
+  asm volatile(
+    "ld.volatile.global.v4.b32 {%0, %1, %2, %3}, [%4];\n"
+    : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w)
+    : "l"(glob_ptr)
+  );
+  return v;
+}
+
 // Async copy fence.
